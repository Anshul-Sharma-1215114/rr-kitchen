{
  "name": "rr-kitchen",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w packages/shared",
    "dev": "npm run build:shared && concurrently -n server,web -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build:shared && npm run build -w apps/server && npm run build -w apps/web",
    "prisma:generate": "npm run prisma:generate -w apps/server",
    "prisma:migrate": "npm run prisma:migrate -w apps/server",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w apps/server",
    "prisma:seed": "npm run prisma:seed -w apps/server",
    "prisma:studio": "npm run prisma:studio -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
