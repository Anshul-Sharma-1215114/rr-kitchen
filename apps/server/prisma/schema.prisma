generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  ADMIN
  DELIVERY_AGENT
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum OrderType {
  DELIVERY
  TAKEAWAY
  DINE_IN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  REJECTED
  CANCELLED
}

// A third value (e.g. GATEWAY) can be added later for Razorpay or similar
// without restructuring the Order model — paymentMethod/paymentStatus are
// already separate, gateway-agnostic fields.
enum PaymentMethod {
  COD
  UPI_MANUAL
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum CouponType {
  FLAT
  PERCENT
}

// ---------- Core ----------

model User {
  id           String   @id @default(cuid())
  role         Role
  name         String
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses           Address[]
  orders              Order[]        @relation("CustomerOrders")
  reviews             Review[]
  deliveryAgentProfile DeliveryAgentProfile?
  assignedOrders      Order[]        @relation("AgentOrders")
  favorites           Favorite[]

  @@index([role])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Address {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     AddressLabel @default(HOME)
  line1     String
  landmark  String?
  area      String
  city      String
  pincode   String
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orders Order[]

  @@index([userId])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  menuItems MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isVeg       Boolean  @default(true)
  available   Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comboItems ComboItem[]
  orderItems OrderItem[]
  favoritedBy Favorite[]

  @@index([categoryId])
}

model Combo {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items      ComboItem[]
  orderItems OrderItem[]
}

// Items bundled inside a combo/thali. `swappable` lets the seller allow
// customers to substitute this slot for another item in the same category.
model ComboItem {
  id         String   @id @default(cuid())
  comboId    String
  combo      Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  swappable  Boolean  @default(false)

  @@index([comboId])
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(10, 2)
  minOrderValue Decimal    @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal?   @db.Decimal(10, 2)
  validFrom     DateTime
  validTo       DateTime
  usageLimit    Int?
  usedCount     Int        @default(0)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())

  orders Order[]
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  customerId          String
  customer            User          @relation("CustomerOrders", fields: [customerId], references: [id])
  addressId           String?
  address             Address?      @relation(fields: [addressId], references: [id])
  type                OrderType
  status              OrderStatus   @default(PLACED)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus @default(UNPAID)

  itemsTotal     Decimal @db.Decimal(10, 2)
  deliveryFee    Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  deliveryAgentId String?
  deliveryAgent   User?   @relation("AgentOrders", fields: [deliveryAgentId], references: [id])

  specialInstructions String?

  placedAt      DateTime  @default(now())
  confirmedAt   DateTime?
  preparingAt   DateTime?
  readyAt       DateTime?
  outForDeliveryAt DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  items  OrderItem[]
  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([deliveryAgentId])
  @@index([status])
}

// A line item snapshots name/price at order time so later menu edits don't
// change historical orders. Exactly one of menuItemId/comboId is set.
model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  comboId    String?
  combo      Combo?   @relation(fields: [comboId], references: [id])
  name       String
  quantity   Int
  priceAtOrder Decimal @db.Decimal(10, 2)
  // For combo line items: { swaps: [{ fromMenuItemId, toMenuItemId }] }
  comboSelections Json?

  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  // Optional per-item ratings: { [orderItemId]: rating }
  itemRatings Json?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model ShopConfig {
  id                String   @id @default("shop_config")
  name              String   @default("RR Kitchen")
  // Flat fee applied to every DELIVERY order, regardless of address — the
  // app doesn't compute or store distance, so this replaced the earlier
  // distance-based fee slabs.
  deliveryFee       Decimal  @default(0) @db.Decimal(10, 2)
  minOrderValue     Decimal  @default(0) @db.Decimal(10, 2)
  taxPercent        Decimal  @default(0) @db.Decimal(5, 2)
  openTime          String   @default("09:00")
  closeTime         String   @default("22:00")
  // Human-readable postal address, shown in the footer/contact section.
  address           String?
  // Shop's UPI VPA (e.g. "rrkitchen@okhdfcbank"), shown to customers as a
  // static, admin-editable QR (generated client-side from this ID — not
  // per-transaction) for "pay via UPI on delivery/pickup".
  upiId             String?
  // WhatsApp number (with country code, e.g. "+919000000000") for the
  // customer-facing "chat with us" floating button. Digits are stripped
  // client-side when building the wa.me link, so formatting here is
  // forgiving.
  whatsappNumber    String?
  updatedAt         DateTime @updatedAt
}

// One-to-one extension of User for delivery-agent-specific state.
model DeliveryAgentProfile {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleNumber String?
  isAvailable   Boolean @default(true)
  isActive      Boolean @default(true)
}
