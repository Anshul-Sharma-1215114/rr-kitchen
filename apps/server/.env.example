# Copy to .env and fill in real values.

NODE_ENV=development
PORT=4000

# Local Postgres — matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://rrkitchen:rrkitchen@localhost:5432/rrkitchen"

# Any long random string in dev; use a real secret in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# The Next.js app's origin, for CORS + cookies
WEB_ORIGIN="http://localhost:3000"

OTP_TTL_MINUTES=5
