# Copy to .env.local and fill in real values.

# The API always runs on the same host as this app (derived at runtime from
# the page's own origin — see src/lib/api-url.ts), on this port.
NEXT_PUBLIC_API_PORT="4000"

# Production only: the web app and API live on different domains (e.g.
# Vercel + Render), so the port-derivation trick above doesn't apply. Set
# this to the API's full URL and it takes priority over NEXT_PUBLIC_API_PORT.
# Leave unset for local/LAN dev.
# NEXT_PUBLIC_API_URL="https://rr-kitchen-api.onrender.com"
